# Copy to .env and fill in. Never commit .env.

# Where the ledger database lives (default: backend/data/houseledger.db)
# HOUSELEDGER_DB=backend/data/houseledger.db

# --- Simulated Alexa+ orchestrator ---
# Live mode uses an OpenAI-compatible LLM endpoint. Without a key, only scripted mode runs.
NVIDIA_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_THINKING=true

# Where the orchestrator finds the FairShare MCP server
# MCP_URL=http://127.0.0.1:8010/mcp
