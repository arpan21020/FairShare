# Copy to .env and fill in. Never commit .env.

# Where the ledger database lives (default: backend/data/houseledger.db)
# HOUSELEDGER_DB=backend/data/houseledger.db

# LLM provider for the simulated Alexa+ orchestrator (Milestone C).
# Not needed for the MCP server, the tests, or scripted demo mode.
# LLM_PROVIDER=
# LLM_API_KEY=
